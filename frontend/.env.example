# ─── Clerk ────────────────────────────────────────────────────────────────
# MOCKED — replace with the real values from https://dashboard.clerk.com
# (Configure → API keys). Both are instance-specific; the pk_ one is public.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk sends users who need to authenticate. These are app routes,
# and they already match the pages in src/app/(auth)/.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where users land after authenticating, when no ?redirect_url is present.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ─── Backend API ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000

# Serve GETs from the fixtures in src/lib/api.ts instead of calling the API,
# for working on the UI with no backend running. Reads only — writes always go
# to the real API and always report their real outcome. Leave unset normally.
# NEXT_PUBLIC_USE_MOCKS=true
